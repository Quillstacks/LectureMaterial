# Claude Code
.claude/

# Markdown notes (Claude memory, design docs, drafts)
# README.md is the GitHub Pages source and stays tracked.
# Contributor-facing markdown is tracked so it shows up on GitHub.
*.md
!README.md
!CONTRIBUTING.md
!AGENTS.md
!slidedesign.md
!.github/**/*.md

# Per-chapter draft wrappers from tools/draft.sh
lecturenotes/*/draft.tex
lecturenotes/*/draft.pdf

# Per-chapter build wrappers from tools/build_chapter_pdfs.sh (transient, header says "do not commit")
lecturenotes/*/_ch_*.tex
lecturenotes/*/_ch_*.pdf

# GIF frame cache from the tuftedark \gif macro (regenerated from gifs/*.gif via gifsplit.sh)
_gifcache/

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.synctex(busy)
*.toc
*.vrb
*.xdv

# Per-unit slide build wrappers from tools/build_unit_pdfs.sh (transient,
# header says "do not commit"). The unit PDFs land in slides/unit_pdfs/.
lecturenotes/*/slides/_unit_*.tex
lecturenotes/*/slides/_unit_*.pdf

# Beamer slide-deck render-test scratch (theme probes, not part of any deck)
lecturenotes/*/slides/rt*.tex
lecturenotes/*/slides/rt*.pdf
lecturenotes/*/slides/measure.tex
lecturenotes/*/slides/measure.pdf
lecturenotes/*/slides/reftest*.tex
lecturenotes/*/slides/reftest*.pdf

# LaTeX save-error artifacts (e.g. disciplined_vibe.bbl-SAVE-ERROR)
*-SAVE-ERROR

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Solutions, exam keys, grading data, student submissions
# (pre-emptive: never expose these even if accidentally dropped into a chapter folder)
solutions/
*_solutions.tex
*_solutions.pdf
*_loesungen.tex
*_loesungen.pdf
grades*.csv
gradebook*
students*.csv

# Per-book exam workspaces. Active exams stay local and MUST stay ignored.
# Publishable exams (Altklausuren, Probeklausuren) live in `open_exams/`
# instead and are tracked. The negation below makes that intent explicit
# and survives any future broader ignore rule under lecturenotes/.
lecturenotes/*/exams/
!lecturenotes/*/open_exams/
!lecturenotes/*/open_exams/**
